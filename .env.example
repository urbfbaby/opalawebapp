# Opala Property Environment Configuration

# Canonical URL & Open Graph (Set to your live domain)
NEXT_PUBLIC_SITE_URL=https://your-domain.com.au

# Staging Indexing Control: false for staging/preview (noindex/nofollow), true for public launch
NEXT_PUBLIC_ALLOW_INDEXING=false

# Supabase Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Admin Dashboard Password (default if unset: opala2026)
ADMIN_PASSWORD=opala2026

# Optional Staging Gate Password
# STAGING_PASSWORD=

# Enquiry Email via Resend (Optional)
# RESEND_API_KEY=
